BACKTEST_STRATEGY=ema_avwap_pullback

# EMA/AVWAP always downloads Binance USDⓈ-M perpetual candles. Both ETHUSDT
# and ETHUSDT.P are accepted; the local canonical/backtest symbol is ETHUSDT.P.
STRATEGY_SYMBOL=ETHUSDT.P
STRATEGY_TIMEFRAME=1h
STRATEGY_LEVERAGE=10
# This is the same entry-notional budget percentage used by live trading; it
# is not stop-loss risk sizing.
STRATEGY_POSITION_NOTIONAL_PCT=1
# Match live MINIMUM_BALANCE_USDT. Entries are skipped at or below this floor.
MINIMUM_BALANCE_USDT=0
# These shared caps use the same names and semantics as the live config.
MAX_POSITION_SIZE_PCT=10
MAX_ENTRY_NOTIONAL_USDT=15
STRATEGY_EMA_LENGTH=55
STRATEGY_CONSECUTIVE_COUNT=4
STRATEGY_EMA_VALIDATION_MODE=body
STRATEGY_SETUP_WAITING_REPLACEMENT_MODE=keep_waiting
STRATEGY_MAX_SETUP_AGE_BARS=3
STRATEGY_MAX_ENTRY_DEVIATION_PCT=1.0
# This is the only live-supported sizing mode.
STRATEGY_POSITION_SIZING_MODE=risk_amount_per_price
# Historical OHLCV backtests should use the same closed-candle state machine
# as live trading's close modes. ``live`` is only an OHLC approximation of
# forming-candle/tick execution, not a replay.
STRATEGY_ENTRY_MODE=close
STRATEGY_EXIT_MODE=close
STRATEGY_EXIT_BAND=band_1
STRATEGY_AVWAP_MULTIPLIER_1=1.0
STRATEGY_AVWAP_MULTIPLIER_2=2.0
STRATEGY_AVWAP_MULTIPLIER_3=3.0
# Required by the live strategy for every entry.
STRATEGY_RIGID_STOP_LOSS_PCT=3
# Activate after AVWAP band 1 plus this percentage, then trail the best price.
# Set the gap above zero; zero exits at the activation price.
STRATEGY_TRAILING_ACTIVATION_THRESHOLD_PCT=0
STRATEGY_TRAILING_GAP_PCT=1.0
STRATEGY_MAKER_FEE_PCT=0.0002
STRATEGY_TAKER_FEE_PCT=0.0006
STRATEGY_ENTRY_SLIPPAGE_PCT=0
# Bitunix exits are market closes. This is always applied adversely to every
# target, trailing, rigid-stop, gap, and end-of-backtest close (0.002 = 0.2%).
STRATEGY_EXIT_SLIPPAGE_PCT=0
# Actual Binance USDⓈ-M settlement history (rate * settlement mark price).
# Set to none only for an explicit zero-funding sensitivity run.
STRATEGY_FUNDING_MODE=historical
STRATEGY_USE_GAP_CROSS_DETECTION=true
STRATEGY_MAX_DECISION_LOG_ENTRIES=20000

BACKTEST_START=2025-01-01T00:00:00Z
BACKTEST_END=2025-03-31T23:59:59Z
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_WARMUP_DAYS=30
OVERRIDE_DOWNLOAD=false

STORE_KIND=postgres
# Optional .env file for candle PostgreSQL settings (CANDLE_DB_* / POSTGRES_*).
STORE_PATH=
STATS_OUTPUT=./backtest_stats.ema_avwap_pullback.json
PLOT_OUTPUT=
SHOW_PLOT=false
SHOW_STOCHASTIC=false
SHOW_EQUITY=true
LOG_LEVEL=INFO
