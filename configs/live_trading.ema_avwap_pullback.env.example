# Live Trading Config (EMA + AVWAP Pullback)
# Copy to: configs/live_trading.ema_avwap_pullback.env

# Exchange
EXCHANGE=bitunix
TRADING_MODE=futures
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
API_PASSPHRASE=

# Strategy
STRATEGY_NAME=ema_avwap_pullback
TIMEFRAME=5m
SYMBOLS=ETHUSDT

# EMA + AVWAP Pullback
LEVERAGE=2
# Entry notional budget as a percentage of the available balance. This is not
# stop-loss risk; it is capped by MAX_POSITION_SIZE_PCT and MAX_ENTRY_NOTIONAL_USDT.
POSITION_NOTIONAL_PCT=100
EMA_LENGTH=55
CONSECUTIVE_COUNT=4
EMA_VALIDATION_MODE=body
SETUP_WAITING_REPLACEMENT_MODE=keep_waiting
# Discard setups that have waited longer than this many completed candles.
MAX_SETUP_AGE_BARS=3
# Reject entries whose current Bitunix price is farther than this from AVWAP.
MAX_ENTRY_DEVIATION_PCT=1.0
# The only supported mode. Its amount is an entry notional budget, not the
# amount that can be lost if the stop is reached.
POSITION_SIZING_MODE=risk_amount_per_price
# close: evaluate the newest closed pullback candle immediately when the next
# forming candle appears. live: evaluate current price against on-the-fly AVWAP.
ENTRY_MODE=live
# close: exit only when the newest closed candle closes at/past the target band.
# live: exit as soon as current price reaches the on-the-fly target band.
EXIT_MODE=live
# band_1 or band_2
EXIT_BAND=band_1
AVWAP_MULTIPLIER_1=1.0
AVWAP_MULTIPLIER_2=2.0
AVWAP_MULTIPLIER_3=3.0
# Required for every entry: Bitunix must confirm this protective stop after fill.
RIGID_STOP_LOSS_PCT=3.0
TRAILING_ACTIVATION_THRESHOLD_PCT=0.0
TRAILING_GAP_PCT=1.0
MAKER_FEE_PCT=0.0002
TAKER_FEE_PCT=0.0006
ENTRY_SLIPPAGE_PCT=0.0
EXIT_SLIPPAGE_PCT=0.0
USE_GAP_CROSS_DETECTION=true

# Live execution safety
ENTRY_CANCEL_BARS=1
MAX_HISTORY_BARS=512
MINIMUM_BALANCE_USDT=0.0
# Poll closed candles at this interval (never less often than TIMEFRAME). The
# zero ready delay processes the newest close immediately; stale boundary data
# is retried without waiting for the following candle. Position management
# continues at POLL_INTERVAL_SECONDS even if Bitunix market data is slow.
CANDLE_READY_DELAY_SECONDS=0
EXECUTION_INTERVAL_MINUTES=5
API_RETRIES=3
API_RETRY_DELAY_SECONDS=1.0
EMERGENCY_CLOSE_ON_STOP_FAILURE=true
ALLOW_DYNAMIC_STOP_WIDENING=true
MIN_STOP_UPDATE_PCT=0.0
POLL_INTERVAL_SECONDS=2.0
TRAILING_CHECK_INTERVAL_SECONDS=2.0
# Require a current Bitunix WebSocket kline update for live entry/exit AVWAP.
# The coordinator skips live indicator evaluation when the stream is older than this.
LIVE_KLINE_STALE_SECONDS=10.0
TRAILING_TICK_TIMEFRAME=1m
USE_TRAILING_TICK_EMULATION=false

# Risk / Positions
MARGIN_MODE=isolated
# Accepted for shared-config compatibility but intentionally ignored by EMA + AVWAP.
POSITION_SIZE_USDT=100.0
# Absolute and percentage caps both limit the entry notional budget.
MAX_ENTRY_NOTIONAL_USDT=20.0
MAX_POSITION_SIZE_PCT=100.0
# EMA + AVWAP applies this as one active/pending entry per symbol, not as an
# account-wide position limit.  Each configured symbol may therefore trade.
MAX_CONCURRENT_POSITIONS=1
DISABLE_SYMBOL_HOURS=0

# Persistence
STATE_FILE=./data/ema_avwap_pullback_live_trading_state.json
POSITIONS_DB=./data/ema_avwap_pullback_live_trading_positions.db
KLINES_DB=./configs/live_trading.ema_avwap_pullback.env
LOG_FILE=./logs/live_trading.ema_avwap_pullback.log
# The bot runs mainnet only. It writes a mainnet-only state marker and refuses
# to load legacy/unscoped state files; reconcile and archive any old state first.
# A second process using the same API key is blocked even if it selects another
# STATE_FILE.

# Optional
# If HTTPS_PROXY is empty, HTTP_PROXY is also used for HTTPS exchange API.
# HTTP_PROXY=
# HTTPS_PROXY=
# PROXY=

# Telegram
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_PROXY=
# TELEGRAM_TIMEOUT=10.0
