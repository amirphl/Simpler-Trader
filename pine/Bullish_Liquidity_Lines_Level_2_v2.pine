//@version=6
indicator("Bullish Liquidity Lines — Level 2 v2", overlay = true, max_lines_count = 500, max_labels_count = 500)

// Level 2 matches representative bullish pivots across every BoS or
// independent CHoCH (iCHoCH) section. A potential BoS opens at the same level
// origin as a confirmed BoS, while an iCHoCH opens at its structural candle
// and remains open until the next section starts. Level 2 v2 records the
// complete historical union of representative-pivot liquidity lines. A line
// is never removed once it was valid on a completed candle.

//=============================================================================
// INPUTS
//=============================================================================

touchCountsAsHunt = input.bool(false, "Touch counts as hunt", group = "Pivot detection")
sameCandleRule = input.string("Low wins", "If high and low are hunted on same candle", options = ["Low wins", "High wins"], group = "Pivot detection")
showPivotMarkers = input.bool(false, "Show pivot markers", group = "Pivot detection")
aliveColor = input.color(color.lime, "Alive pivot color", group = "Pivot detection")
deadColor = input.color(color.red, "Dead pivot color", group = "Pivot detection")
offsetTicks = input.int(10, "Icon offset ticks", minval = 0, group = "Pivot detection")
iconSizeInput = input.string("Large", "Icon size", options = ["Small", "Normal", "Large", "Huge"], group = "Pivot detection")
iconSize = iconSizeInput == "Small" ? size.small : iconSizeInput == "Normal" ? size.normal : iconSizeInput == "Huge" ? size.huge : size.large

directionWindow = input.int(3, "Initial direction window", minval = 1, group = "BoS sections")
huntModeInput = input.string("wick", "Hunt mode", options = ["wick", "close"], group = "BoS sections")
minSwingPct = input.float(0.0, "Minimum swing percent", step = 0.01, minval = 0.0, group = "BoS sections")
includePullbackInBosLevel = input.bool(true, "Include first pullback candle in BoS level scan", group = "BoS sections")
chochMarkerLengthBars = input.int(1, "CHoCH marker length (bars)", minval = 1, maxval = 10, group = "BoS sections")
markerOffsetTicks = input.int(6, "Marker vertical offset (ticks)", minval = 0, group = "BoS sections")
markerWidth = input.int(2, "BOS line width", minval = 1, maxval = 5, group = "BoS sections")
chochMarkerWidth = input.int(3, "CHoCH marker width", minval = 1, maxval = 5, group = "BoS sections")
bullBosColor = input.color(color.lime, "Bullish BOS color", group = "BoS sections")
bearBosColor = input.color(color.red, "Bearish BOS color", group = "BoS sections")
bearChochColor = input.color(color.yellow, "Bearish CHoCH color", group = "BoS sections")
bullChochColor = input.color(color.blue, "Bullish CHoCH color", group = "BoS sections")
color independentChochColor = color.purple

showLiquidityLines = input.bool(true, "Show historical bullish liquidity lines", group = "Liquidity lines")
liquidityLineWidth = input.int(2, "Line width", minval = 1, maxval = 5, group = "Liquidity lines")
historicalLineColor = input.color(color.aqua, "Historical line color", group = "Liquidity lines")
showDebug = input.bool(false, "Show debug values in Data Window", group = "Debug")

//=============================================================================
// CONSTANTS AND TYPES
//=============================================================================

int PENDING = 0
int ALIVE = 1
int DEAD = 2
int INVALID = 3
int WAIT_NEXT = 0
int GREEN_RUN = 1
int NORMAL = 3
int DIR_UP = 1
int DIR_DOWN = -1
int PHASE_WAIT_PULLBACK = 0
int PHASE_FORMING = 1
int PHASE_AWAIT_HUNT = 2
int BOS_FORMING = 0
int BOS_COMPLETE = 1
int BOS_CONFIRMED = 2

type Pivot
    int createdBar
    float minLow
    int minLowBar
    float maxHigh
    float runningMin
    int runningMinBar
    float pivotLow
    int pivotBar
    int state
    int phase
    int confirmedBar
    bool hunted
    label marker

type BosRec
    int index
    int direction
    int anchorIndex
    int startIndex
    float level
    int levelLastUpdatedIndex
    int completeIndex
    int huntIndex
    int state
    bool hunted

type ChochTrack
    int bosIndex
    int candleIndex // initial structural CHoCH candle
    float level // current live level required for cascade detection
    int firstHuntCandleIndex // retained once; later hunts are not stored
    int direction
    bool active

type IndependentChochRec
    int candleIndex
    float level
    int direction

// BoS sections open as soon as a BoS starts forming, at their level-origin
// candle. iCHoCH sections open at their structural candle. Both use this same
// range type and the liquidity code below deliberately does not branch on the
// section origin.
type LiquiditySection
    int id
    int startBar
    int endBar
    bool active
    bool confirmedBos
    line independentChochDrawing
    int representativePivotId
    bool representativeDirty

// Immutable identity includes the candidate IDs and the pivot candles. A
// pending candidate can move its running-low to a new candle, which represents
// a new potential pivot and must be able to create a separate historical line.
type HistoricalLiquidityLine
    int sequenceNumber
    string key
    int olderPivotId
    int newerPivotId
    int olderPivotBar
    int newerPivotBar
    float level
    line drawing

//=============================================================================
// STORAGE
//=============================================================================

var array<Pivot> candidates = array.new<Pivot>()
var array<int> alivePivotIds = array.new_int()
// Potential bullish pivots waiting for confirmation or invalidation.
var array<int> pendingBullishPivotIds = array.new_int()
// Complete live bullish-pivot registry: PENDING potential pivots plus ALIVE
// confirmed pivots. Invalidated and hunted pivots are removed immediately.
var array<int> activeBullishPivotIds = array.new_int()
var array<BosRec> bosRecords = array.new<BosRec>()
var array<ChochTrack> chochTracks = array.new<ChochTrack>()
var array<IndependentChochRec> independentChochRecords = array.new<IndependentChochRec>()
var array<int> activeBosIds = array.new_int()
var array<LiquiditySection> liquiditySections = array.new<LiquiditySection>()
// The section currently being evaluated by the BoS state machine. It is not
// added retroactively: it becomes live as soon as PHASE_FORMING starts.
var int activePotentialBosSectionId = na
// The currently open iCHoCH section. It is closed only when another section
// obtains its start bar, preserving the full iCHoCH range in between.
var int activeIndependentChochSectionId = na
// A potential BoS can improve its level-origin while it forms. Retain the
// preceding iCHoCH ID so its exclusive endpoint follows that final start bar.
var int independentChochBeforePotentialBosSectionId = na
// Pine has no set type, so this map is the authoritative set of historical
// line keys. Its value is the one-based creation sequence number.
var map<string, int> historicalLineSequenceByKey = map.new<string, int>()
var array<HistoricalLiquidityLine> historicalLiquidityLines = array.new<HistoricalLiquidityLine>()
var bool initialized = false
var int direction = na
var int directionSinceIndex = na
var int anchorIndex = na
var int bosPhase = PHASE_WAIT_PULLBACK
var int formingStartIndex = na
var float formingLevel = na
var int formingLevelLastUpdatedIndex = na
var int formingCompleteIndex = na
var int bosCounter = 0
var bool hasIndependentChoch = false
var float independentChochLevel = na
var int independentChochCandleIndex = na
var int independentChochDirection = na

var float dbgLastBosLevel = na
var int dbgLastBosStartIndex = na
var int dbgLastBosHuntIndex = na
var float dbgLastChochLevel = na
var int dbgLastChochCandleIndex = na
var int dbgDirection = na

var int redCount = 0
var float redMin = na
var int redMinBar = na
var float redMax = na
var float precedingGreenMax = na

//=============================================================================
// GENERAL AND PIVOT HELPERS
//=============================================================================

f_highHunted(float h, float level) =>
    touchCountsAsHunt ? h >= level : h > level

f_lowHunted(float l, float level) =>
    touchCountsAsHunt ? l <= level : l < level

f_removeInt(array<int> values, int value) =>
    if array.size(values) > 0
        for i = array.size(values) - 1 to 0
            if array.get(values, i) == value
                array.remove(values, i)

f_clearIntArray(array<int> values) =>
    while array.size(values) > 0
        array.pop(values)

f_sectionContainsPivotBar(LiquiditySection section, int pivotBar) =>
    int sectionEnd = section.active ? bar_index : section.endBar
    not na(pivotBar) and not na(sectionEnd) and pivotBar >= section.startBar and pivotBar <= sectionEnd

// Refresh every section containing a changed pivot. A pivot's running-min
// candle can move before it is confirmed, so narrower representative-only
// invalidation can miss the final representative of a just-closed section.
// Sections deliberately have no trend-direction filter: bullish liquidity is
// valid in both UP and DOWN market structures.
f_markSectionsContainingPivotDirty(int pivotId, int pivotBar) =>
    if not na(pivotBar) and array.size(liquiditySections) > 0
        for sectionId = 0 to array.size(liquiditySections) - 1
            LiquiditySection section = array.get(liquiditySections, sectionId)
            if f_sectionContainsPivotBar(section, pivotBar)
                section.representativeDirty := true
                array.set(liquiditySections, sectionId, section)

f_pivotLevel(Pivot p) =>
    p.state == PENDING ? p.runningMin : p.pivotLow

f_pivotCandle(Pivot p) =>
    p.state == PENDING ? p.runningMinBar : p.pivotBar

f_pivotIsEligible(Pivot p, int sectionStart, int sectionEnd) =>
    bool pendingOrAlive = p.state == PENDING or p.state == ALIVE
    int pivotBar = f_pivotCandle(p)
    // Section membership follows the actual pivot candle. Candidate creation
    // and confirmation bars are intentionally irrelevant to this decision.
    bool insideSection = not na(pivotBar) and pivotBar >= sectionStart and pivotBar <= sectionEnd
    pendingOrAlive and not p.hunted and insideSection and not na(f_pivotLevel(p))

f_confirmPivot(int pivotId) =>
    Pivot p = array.get(candidates, pivotId)
    if p.state == PENDING
        p.state := ALIVE
        p.pivotLow := p.runningMin
        p.pivotBar := p.runningMinBar
        p.confirmedBar := bar_index
        if showPivotMarkers
            p.marker := label.new(x = p.pivotBar, y = p.pivotLow - syminfo.mintick * offsetTicks, text = "▲", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = aliveColor, size = iconSize)
        f_removeInt(alivePivotIds, pivotId)
        f_removeInt(pendingBullishPivotIds, pivotId)
        array.push(alivePivotIds, pivotId)
        array.set(candidates, pivotId, p)
        f_markSectionsContainingPivotDirty(pivotId, p.pivotBar)

f_invalidatePivot(int pivotId) =>
    Pivot p = array.get(candidates, pivotId)
    if p.state == PENDING
        f_markSectionsContainingPivotDirty(pivotId, p.runningMinBar)
        f_removeInt(pendingBullishPivotIds, pivotId)
        f_removeInt(activeBullishPivotIds, pivotId)
        p.state := INVALID
        array.set(candidates, pivotId, p)

f_destroyPivot(int pivotId) =>
    Pivot p = array.get(candidates, pivotId)
    if p.state == ALIVE
        f_markSectionsContainingPivotDirty(pivotId, p.pivotBar)
        f_removeInt(activeBullishPivotIds, pivotId)
        p.state := DEAD
        p.hunted := true
        if not na(p.marker)
            label.set_text(p.marker, "×")
            label.set_textcolor(p.marker, deadColor)
        array.set(candidates, pivotId, p)

//=============================================================================
// BoS/CHoCH HELPERS
//=============================================================================

f_offsetFromAbsIndex(int absIndex) =>
    bar_index - absIndex

f_highAt(int absIndex) =>
    int offset = f_offsetFromAbsIndex(absIndex)
    offset >= 0 and offset <= bar_index ? high[offset] : na

f_lowAt(int absIndex) =>
    int offset = f_offsetFromAbsIndex(absIndex)
    offset >= 0 and offset <= bar_index ? low[offset] : na

f_openAt(int absIndex) =>
    int offset = f_offsetFromAbsIndex(absIndex)
    offset >= 0 and offset <= bar_index ? open[offset] : na

f_closeAt(int absIndex) =>
    int offset = f_offsetFromAbsIndex(absIndex)
    offset >= 0 and offset <= bar_index ? close[offset] : na

f_sideAt(int absIndex) =>
    float o = f_openAt(absIndex)
    float c = f_closeAt(absIndex)
    int side = 0
    if not na(o) and not na(c)
        if c > o
            side := 1
        else if c < o
            side := -1
    side

f_isOpposite(int dir, bool isBull, bool isBear) =>
    dir == DIR_UP ? isBear : isBull

f_isResume(int dir, bool isBull, bool isBear) =>
    dir == DIR_UP ? isBull : isBear

f_extremeValue(int dir, int absIndex) =>
    dir == DIR_UP ? f_highAt(absIndex) : f_lowAt(absIndex)

f_bosHunted(int dir, float level, string huntMode) =>
    dir == DIR_UP ? (huntMode == "wick" ? high : close) >= level : (huntMode == "wick" ? low : close) <= level

f_chochHunted(int dir, float level, string huntMode) =>
    dir == DIR_UP ? (huntMode == "wick" ? low : close) <= level : (huntMode == "wick" ? high : close) >= level

f_newChochLevel(int dir, string huntMode) =>
    dir == DIR_UP ? (huntMode == "wick" ? low : close) : (huntMode == "wick" ? high : close)

f_rangeCounterTrendExtreme(int dir, int startIdx, int endIdx) =>
    float outLevel = na
    int outIndex = na
    if startIdx <= endIdx
        outLevel := dir == DIR_UP ? f_lowAt(startIdx) : f_highAt(startIdx)
        outIndex := startIdx
        if endIdx > startIdx
            for index = startIdx + 1 to endIdx
                float candidate = dir == DIR_UP ? f_lowAt(index) : f_highAt(index)
                if not na(candidate) and (dir == DIR_UP ? candidate < outLevel : candidate > outLevel)
                    outLevel := candidate
                    outIndex := index
    [outLevel, outIndex]

// The confirmation candle is a structural boundary, so it cannot become the
// initial CHoCH source for the BoS it confirms.
f_initialChoch(int dir, int startIdx, int huntIdx) =>
    f_rangeCounterTrendExtreme(dir, startIdx, huntIdx - 1)

f_drawMarkerLine(int absIndex, color clr, string sty, bool isBullish) =>
    if absIndex >= 0 and absIndex <= bar_index
        int offset = f_offsetFromAbsIndex(absIndex)
        if offset >= 0 and offset <= bar_index
            float y = isBullish ? high[offset] + syminfo.mintick * markerOffsetTicks : low[offset] - syminfo.mintick * markerOffsetTicks
            line.new(x1 = absIndex, y1 = y, x2 = absIndex + chochMarkerLengthBars, y2 = y, xloc = xloc.bar_index, extend = extend.none, color = clr, style = sty, width = chochMarkerWidth)

f_drawBosLine(int levelIndex, int huntIndex, float level, color clr) =>
    if levelIndex >= 0 and levelIndex <= huntIndex and huntIndex <= bar_index
        line.new(x1 = levelIndex, y1 = level, x2 = huntIndex, y2 = level, xloc = xloc.bar_index, extend = extend.none, color = clr, style = line.style_solid, width = markerWidth)

f_drawIndependentChochLine(int absIndex, bool isBullish, int endIndex) =>
    line drawing = na
    if absIndex >= 0 and absIndex <= endIndex and endIndex <= bar_index
        int offset = f_offsetFromAbsIndex(absIndex)
        if offset >= 0 and offset <= bar_index
            float y = isBullish ? high[offset] + syminfo.mintick * markerOffsetTicks : low[offset] - syminfo.mintick * markerOffsetTicks
            drawing := line.new(x1 = absIndex, y1 = y, x2 = endIndex, y2 = y, xloc = xloc.bar_index, extend = extend.none, color = independentChochColor, style = line.style_solid, width = chochMarkerWidth)
    drawing

f_addBosSection(int levelOriginBar, bool confirmedBos) =>
    int sectionId = array.size(liquiditySections)
    LiquiditySection section = LiquiditySection.new(id = sectionId, startBar = levelOriginBar, endBar = na, active = true, confirmedBos = confirmedBos, independentChochDrawing = na, representativePivotId = na, representativeDirty = true)
    array.push(liquiditySections, section)
    sectionId

f_addIndependentChochSection(int chochStartBar, bool isBullish) =>
    // `confirmedBos` is lifecycle metadata only; liquidity matching treats
    // this record exactly like every other LiquiditySection.
    int sectionId = f_addBosSection(chochStartBar, false)
    LiquiditySection section = array.get(liquiditySections, sectionId)
    section.independentChochDrawing := f_drawIndependentChochLine(chochStartBar, isBullish, bar_index)
    array.set(liquiditySections, sectionId, section)
    sectionId

f_setPotentialBosSectionStart(int sectionId, int levelOriginBar) =>
    if sectionId >= 0 and sectionId < array.size(liquiditySections)
        LiquiditySection section = array.get(liquiditySections, sectionId)
        if section.active and not section.confirmedBos and section.startBar != levelOriginBar
            section.startBar := levelOriginBar
            section.representativeDirty := true
            array.set(liquiditySections, sectionId, section)

f_confirmBosSection(int sectionId) =>
    if sectionId >= 0 and sectionId < array.size(liquiditySections)
        LiquiditySection section = array.get(liquiditySections, sectionId)
        if section.active and not section.confirmedBos
            section.confirmedBos := true
            section.representativeDirty := true
            array.set(liquiditySections, sectionId, section)

f_closeSection(int sectionId, int endBar) =>
    if sectionId >= 0 and sectionId < array.size(liquiditySections)
        LiquiditySection section = array.get(liquiditySections, sectionId)
        section.endBar := endBar
        section.active := false
        if not na(section.independentChochDrawing)
            if endBar >= section.startBar
                line.set_x2(section.independentChochDrawing, endBar)
            else
                // Two adjacent structural starts can leave an empty iCHoCH
                // range; an empty logical range must have no visual marker.
                line.delete(section.independentChochDrawing)
                section.independentChochDrawing := na
        // The reversal candle is processed by the pivot state machine later
        // in this bar. Re-evaluate the final closed window after that update.
        section.representativeDirty := true
        array.set(liquiditySections, sectionId, section)

// Confirmed BoS sections overlap during one structure, but all terminate
// together when that structure reverses. The potential section is closed
// separately with its exclusive iCHoCH boundary before this function runs.
f_closeActiveBosSections(int endBar) =>
    if array.size(liquiditySections) > 0
        for sectionId = 0 to array.size(liquiditySections) - 1
            LiquiditySection section = array.get(liquiditySections, sectionId)
            if section.active and section.confirmedBos
                f_closeSection(sectionId, endBar)

//=============================================================================
// SHARED PIVOT-PAIRING RULES
//=============================================================================

f_candlesIntersect(int olderBar, int newerBar) =>
    int olderOffset = bar_index - olderBar
    int newerOffset = bar_index - newerBar
    bool validOffsets = olderOffset >= 0 and olderOffset <= bar_index and newerOffset >= 0 and newerOffset <= bar_index
    bool intersects = false
    if validOffsets
        intersects := math.max(low[olderOffset], low[newerOffset]) <= math.min(high[olderOffset], high[newerOffset])
    intersects

f_pendingPairIsAllowed(Pivot older, Pivot newer) =>
    // The historical state table permits only ALIVE -> ALIVE and
    // PENDING -> ALIVE. In particular, an ALIVE representative can never be
    // paired with a newer representative that is still only potential.
    (older.state == ALIVE and newer.state == ALIVE) or (older.state == PENDING and newer.state == ALIVE)

// Match chronology is defined by the actual pivot candle, never by the bar
// where a candidate was created or later confirmed. A pending pivot uses its
// current running-min candle until it becomes confirmed.
f_pivotComesBefore(int leftId, int rightId) =>
    Pivot left = array.get(candidates, leftId)
    Pivot right = array.get(candidates, rightId)
    int leftBar = f_pivotCandle(left)
    int rightBar = f_pivotCandle(right)
    // A tie cannot form a pair because f_pairIsValid requires `olderBar <
    // newerBar`; the id merely makes the otherwise-equal ordering stable.
    leftBar < rightBar or (leftBar == rightBar and leftId < rightId)

f_pairIsValid(int olderId, int newerId) =>
    Pivot older = array.get(candidates, olderId)
    Pivot newer = array.get(candidates, newerId)
    int olderBar = f_pivotCandle(older)
    int newerBar = f_pivotCandle(newer)
    olderBar < newerBar and f_pendingPairIsAllowed(older, newer) and f_pivotLevel(newer) > f_pivotLevel(older) and f_candlesIntersect(olderBar, newerBar)

//=============================================================================
// LEVEL 2 v2: APPEND-ONLY HISTORICAL REPRESENTATIVE LIQUIDITY
//=============================================================================

// The representative is the eligible pivot with the earliest actual pivot
// candle in a section. Candidate creation and confirmation bars are
// irrelevant to this selection; section origin is irrelevant as well.
f_oldestRepresentativePivotId(LiquiditySection section) =>
    int representativeId = na
    int sectionEnd = section.active ? bar_index : section.endBar
    if not na(sectionEnd) and array.size(activeBullishPivotIds) > 0
        for livePos = 0 to array.size(activeBullishPivotIds) - 1
            int pivotId = array.get(activeBullishPivotIds, livePos)
            Pivot p = array.get(candidates, pivotId)
            if f_pivotIsEligible(p, section.startBar, sectionEnd)
                if na(representativeId) or f_pivotComesBefore(pivotId, representativeId)
                    representativeId := pivotId
    representativeId

f_refreshSectionRepresentative(int sectionId) =>
    LiquiditySection section = array.get(liquiditySections, sectionId)
    bool representativeWasDirty = section.representativeDirty
    if section.representativeDirty
        int nextRepresentativeId = f_oldestRepresentativePivotId(section)
        section.representativePivotId := nextRepresentativeId
        section.representativeDirty := false
        array.set(liquiditySections, sectionId, section)
    // A pivot may retain its candidate ID while its potential-pivot candle or
    // level changes. The caller therefore re-runs matching whenever a section
    // is refreshed, even if the selected candidate ID did not change.
    representativeWasDirty

f_historicalLineKey(int olderId, int olderBar, int newerId, int newerBar) =>
    str.tostring(olderId) + "@" + str.tostring(olderBar) + ":" + str.tostring(newerId) + "@" + str.tostring(newerBar)

f_recordHistoricalLiquidityLine(int olderId, int newerId) =>
    Pivot older = array.get(candidates, olderId)
    Pivot newer = array.get(candidates, newerId)
    float level = f_pivotLevel(older)
    int olderBar = f_pivotCandle(older)
    int newerBar = f_pivotCandle(newer)
    string key = f_historicalLineKey(olderId, olderBar, newerId, newerBar)
    if not map.contains(historicalLineSequenceByKey, key)
        // Historical lines are append-only, so the current count supplies a
        // stable one-based creation sequence without mutating a global from
        // inside this function.
        int sequenceNumber = array.size(historicalLiquidityLines) + 1
        line drawing = na
        if showLiquidityLines
            // Link the two pivot prices directly, rather than projecting the
            // older pivot's level horizontally to the newer pivot candle.
            drawing := line.new(x1 = olderBar, y1 = level, x2 = newerBar, y2 = f_pivotLevel(newer), xloc = xloc.bar_index, extend = extend.none, color = historicalLineColor, width = liquidityLineWidth)
        HistoricalLiquidityLine liquidity = HistoricalLiquidityLine.new(sequenceNumber = sequenceNumber, key = key, olderPivotId = olderId, newerPivotId = newerId, olderPivotBar = olderBar, newerPivotBar = newerBar, level = level, drawing = drawing)
        array.push(historicalLiquidityLines, liquidity)
        map.put(historicalLineSequenceByKey, key, sequenceNumber)

f_sortRepresentativeIdsByCandle(array<int> representativeIds) =>
    if array.size(representativeIds) > 1
        for currentPos = 1 to array.size(representativeIds) - 1
            int scanPos = currentPos
            while scanPos > 0 and f_pivotComesBefore(array.get(representativeIds, scanPos), array.get(representativeIds, scanPos - 1))
                int currentId = array.get(representativeIds, scanPos)
                array.set(representativeIds, scanPos, array.get(representativeIds, scanPos - 1))
                array.set(representativeIds, scanPos - 1, currentId)
                scanPos -= 1

f_matchHistoricalRepresentatives() =>
    // Cached section representatives are the state known at this candle. The
    // newest-to-oldest greedy scan preserves the existing matching behavior
    // while avoiding a candle-history replay on every bar.
    array<int> representativeIds = array.new_int()
    if array.size(liquiditySections) > 0
        for sectionPos = 0 to array.size(liquiditySections) - 1
            LiquiditySection section = array.get(liquiditySections, sectionPos)
            if not na(section.representativePivotId)
                array.push(representativeIds, section.representativePivotId)
    f_sortRepresentativeIdsByCandle(representativeIds)
    int representativeCount = array.size(representativeIds)
    if representativeCount >= 2
        array<bool> consumed = array.new_bool(representativeCount, false)
        for newerPos = representativeCount - 1 to 1
            if not array.get(consumed, newerPos)
                int newerId = array.get(representativeIds, newerPos)
                bool matched = false
                for olderPos = newerPos - 1 to 0
                    if not matched and not array.get(consumed, olderPos)
                        int olderId = array.get(representativeIds, olderPos)
                        if f_pairIsValid(olderId, newerId)
                            f_recordHistoricalLiquidityLine(olderId, newerId)
                            array.set(consumed, olderPos, true)
                            array.set(consumed, newerPos, true)
                            matched := true

//=============================================================================
// MAIN: BoS/CHoCH DETECTION AND SECTION LIFECYCLE
//=============================================================================

if barstate.isconfirmed and not initialized and bar_index >= directionWindow - 1
    int effective = math.min(directionWindow, bar_index + 1)
    int score = 0
    for absIndex = 0 to effective - 1
        score += f_sideAt(absIndex)
    int inferred = DIR_UP
    if score > 0
        inferred := DIR_UP
    else if score < 0
        inferred := DIR_DOWN
    else
        for absIndex = effective - 1 to 0
            int side = f_sideAt(absIndex)
            if side != 0
                inferred := side > 0 ? DIR_UP : DIR_DOWN
                break
    direction := inferred
    directionSinceIndex := effective - 1
    anchorIndex := directionSinceIndex
    initialized := true
    dbgDirection := direction

bool sectionDataChanged = false
if barstate.isconfirmed and initialized and bar_index >= directionSinceIndex
    bool isBull = close > open
    bool isBear = close < open
    bool reversedNow = false

    if f_isOpposite(direction, isBull, isBear) and array.size(activeBosIds) > 0
        int newestBosId = array.get(activeBosIds, array.size(activeBosIds) - 1)
        bool newestHunted = false
        for activeIdPos = 0 to array.size(activeBosIds) - 1
            int bosId = array.get(activeBosIds, activeIdPos)
            // Match the BoS/CHoCH detector's guard: a stale active ID must
            // never be used as an array index.
            if bosId >= 0 and bosId < array.size(chochTracks)
                ChochTrack track = array.get(chochTracks, bosId)
                if track.active and f_chochHunted(direction, track.level, huntModeInput)
                    float newLevel = f_newChochLevel(direction, huntModeInput)
                    if na(track.firstHuntCandleIndex)
                        track.firstHuntCandleIndex := bar_index
                    track.level := newLevel
                    array.set(chochTracks, bosId, track)
                    dbgLastChochLevel := newLevel
                    dbgLastChochCandleIndex := bar_index
                    // The reversal below emits the independent CHoCH for the
                    // newest active BOS. Drawing this per-BOS marker as well
                    // would create a redundant terminal CHoCH.
                    if bosId == newestBosId
                        newestHunted := true
        if newestHunted
            // The forming section has already been live since its level was
            // found. An iCHoCH invalidates it at the bar before this boundary;
            // do not add a second, retroactive copy of the same section.
            if not na(activePotentialBosSectionId)
                f_closeSection(activePotentialBosSectionId, bar_index - 1)
                activePotentialBosSectionId := na
                independentChochBeforePotentialBosSectionId := na
                sectionDataChanged := true
            int newDirection = direction == DIR_UP ? DIR_DOWN : DIR_UP
            BosRec newestBos = array.get(bosRecords, newestBosId)
            // The CHoCH-hunt candle closes the prior structure and is not an
            // input to the iCHoCH it creates.
            [independentLevel, independentIndex] = f_rangeCounterTrendExtreme(newDirection, newestBos.startIndex, bar_index - 1)
            independentChochLevel := independentLevel
            independentChochCandleIndex := independentIndex
            independentChochDirection := newDirection
            // The prior iCHoCH ends immediately before this iCHoCH's own
            // structural start candle, not on its detection/hunt candle.
            if not na(activeIndependentChochSectionId)
                f_closeSection(activeIndependentChochSectionId, independentIndex - 1)
                sectionDataChanged := true
            activeIndependentChochSectionId := f_addIndependentChochSection(independentIndex, newDirection == DIR_DOWN)
            independentChochBeforePotentialBosSectionId := na
            sectionDataChanged := true
            IndependentChochRec independentChoch = IndependentChochRec.new(candleIndex = independentIndex, level = independentLevel, direction = newDirection)
            array.push(independentChochRecords, independentChoch)
            hasIndependentChoch := true
            direction := newDirection
            directionSinceIndex := bar_index
            dbgDirection := direction
            f_clearIntArray(activeBosIds)
            bosPhase := PHASE_WAIT_PULLBACK
            formingStartIndex := na
            formingLevel := na
            formingLevelLastUpdatedIndex := na
            formingCompleteIndex := na
            anchorIndex := bar_index + 1
            reversedNow := true
            f_closeActiveBosSections(bar_index)
            sectionDataChanged := true

    if not reversedNow and hasIndependentChoch and f_isOpposite(direction, isBull, isBear)
        if f_chochHunted(direction, independentChochLevel, huntModeInput)
            // See the matching iCHoCH branch above: close the live potential
            // section rather than constructing its historical window now.
            if not na(activePotentialBosSectionId)
                f_closeSection(activePotentialBosSectionId, bar_index - 1)
                activePotentialBosSectionId := na
                independentChochBeforePotentialBosSectionId := na
                sectionDataChanged := true
            int newDirection = direction == DIR_UP ? DIR_DOWN : DIR_UP
            // An independent-CHoCH hunt has the same exclusive boundary.
            [independentLevel, independentIndex] = f_rangeCounterTrendExtreme(newDirection, independentChochCandleIndex, bar_index - 1)
            independentChochLevel := independentLevel
            independentChochCandleIndex := independentIndex
            independentChochDirection := newDirection
            // Consecutive iCHoCHs share the same exclusive boundary rule as
            // an iCHoCH followed by a BoS.
            if not na(activeIndependentChochSectionId)
                f_closeSection(activeIndependentChochSectionId, independentIndex - 1)
                sectionDataChanged := true
            activeIndependentChochSectionId := f_addIndependentChochSection(independentIndex, newDirection == DIR_DOWN)
            independentChochBeforePotentialBosSectionId := na
            sectionDataChanged := true
            IndependentChochRec independentChoch = IndependentChochRec.new(candleIndex = independentIndex, level = independentLevel, direction = newDirection)
            array.push(independentChochRecords, independentChoch)
            hasIndependentChoch := true
            direction := newDirection
            directionSinceIndex := bar_index
            dbgDirection := direction
            bosPhase := PHASE_WAIT_PULLBACK
            formingStartIndex := na
            formingLevel := na
            formingLevelLastUpdatedIndex := na
            formingCompleteIndex := na
            anchorIndex := bar_index + 1
            reversedNow := true
            f_closeActiveBosSections(bar_index)
            sectionDataChanged := true

    if not reversedNow
        if bosPhase == PHASE_WAIT_PULLBACK
            if f_isOpposite(direction, isBull, isBear)
                int startScan = anchorIndex
                int endScan = includePullbackInBosLevel ? bar_index : bar_index - 1
                // With the boundary excluded, a first pullback cannot fall
                // back to the previous boundary candle when pullbacks are
                // excluded from this scan. Seed it from itself instead.
                if endScan < startScan
                    startScan := bar_index
                    endScan := bar_index
                float level = f_extremeValue(direction, startScan)
                int levelIndex = startScan
                if endScan > startScan
                    for absIndex = startScan + 1 to endScan
                        float candidateLevel = f_extremeValue(direction, absIndex)
                        bool isBetterLevel = direction == DIR_UP ? candidateLevel > level : candidateLevel < level
                        if isBetterLevel
                            level := candidateLevel
                            levelIndex := absIndex
                formingStartIndex := bar_index
                formingLevel := level
                formingLevelLastUpdatedIndex := levelIndex
                formingCompleteIndex := na
                bosPhase := PHASE_FORMING
                // A potential BoS uses the exact same start-bar rule as a
                // confirmed one. This lets trailing candles participate now,
                // before the confirmation candle is known.
                if not na(activeIndependentChochSectionId)
                    // A BoS is the next section after this iCHoCH, so the
                    // iCHoCH's endpoint is the candle immediately before the
                    // BoS start. Keep its ID while the potential level can
                    // still move, so that endpoint remains exact.
                    f_closeSection(activeIndependentChochSectionId, formingLevelLastUpdatedIndex - 1)
                    independentChochBeforePotentialBosSectionId := activeIndependentChochSectionId
                    activeIndependentChochSectionId := na
                    sectionDataChanged := true
                activePotentialBosSectionId := f_addBosSection(formingLevelLastUpdatedIndex, false)
                sectionDataChanged := true

        else if bosPhase == PHASE_FORMING
            if f_isResume(direction, isBull, isBear)
                formingCompleteIndex := bar_index
                bosPhase := PHASE_AWAIT_HUNT
                if f_bosHunted(direction, formingLevel, huntModeInput)
                    [chochLevel, chochIndex] = f_initialChoch(direction, formingLevelLastUpdatedIndex, bar_index)
                    bool passFilter = true
                    if minSwingPct > 0.0
                        float swing = math.abs(formingLevel - chochLevel)
                        float midpoint = (formingLevel + chochLevel) / 2.0
                        passFilter := midpoint <= 0.0 or swing / midpoint * 100.0 >= minSwingPct
                    if passFilter
                        BosRec bos = BosRec.new(index = bosCounter, direction = direction, anchorIndex = anchorIndex, startIndex = formingStartIndex, level = formingLevel, levelLastUpdatedIndex = formingLevelLastUpdatedIndex, completeIndex = formingCompleteIndex, huntIndex = bar_index, state = BOS_CONFIRMED, hunted = true)
                        array.push(bosRecords, bos)
                        ChochTrack track = ChochTrack.new(bosIndex = bosCounter, candleIndex = chochIndex, level = chochLevel, firstHuntCandleIndex = na, direction = direction, active = true)
                        array.push(chochTracks, track)
                        array.push(activeBosIds, bosCounter)
                        color bosClr = direction == DIR_UP ? bullBosColor : bearBosColor
                        color chochClr = direction == DIR_UP ? bearChochColor : bullChochColor
                        f_drawBosLine(formingLevelLastUpdatedIndex, bar_index, formingLevel, bosClr)
                        f_drawMarkerLine(chochIndex, chochClr, line.style_solid, direction == DIR_DOWN)
                        dbgLastBosLevel := formingLevel
                        dbgLastBosStartIndex := formingStartIndex
                        dbgLastBosHuntIndex := bar_index
                        dbgLastChochLevel := chochLevel
                        dbgLastChochCandleIndex := chochIndex
                        f_confirmBosSection(activePotentialBosSectionId)
                        activePotentialBosSectionId := na
                        independentChochBeforePotentialBosSectionId := na
                        sectionDataChanged := true
                        bosCounter += 1
                        hasIndependentChoch := false
                    else if not na(activePotentialBosSectionId)
                        // A rejected swing follows the existing reset path,
                        // so its potential section must not stay active.
                        f_closeSection(activePotentialBosSectionId, bar_index - 1)
                        activePotentialBosSectionId := na
                        independentChochBeforePotentialBosSectionId := na
                        sectionDataChanged := true
                    bosPhase := PHASE_WAIT_PULLBACK
                    formingStartIndex := na
                    formingLevel := na
                    formingLevelLastUpdatedIndex := na
                    formingCompleteIndex := na
                    anchorIndex := bar_index + 1
            else if f_isOpposite(direction, isBull, isBear)
                float candidateLevel = direction == DIR_UP ? high : low
                bool isBetterLevel = direction == DIR_UP ? candidateLevel > formingLevel : candidateLevel < formingLevel
                if isBetterLevel
                    formingLevel := candidateLevel
                    formingLevelLastUpdatedIndex := bar_index
                    f_setPotentialBosSectionStart(activePotentialBosSectionId, formingLevelLastUpdatedIndex)
                    // The potential BoS start is the next section boundary.
                    // Re-anchor the preceding iCHoCH endpoint with it.
                    if not na(independentChochBeforePotentialBosSectionId)
                        f_closeSection(independentChochBeforePotentialBosSectionId, formingLevelLastUpdatedIndex - 1)
                    sectionDataChanged := true

        else if bosPhase == PHASE_AWAIT_HUNT
            if f_bosHunted(direction, formingLevel, huntModeInput)
                [chochLevel, chochIndex] = f_initialChoch(direction, formingLevelLastUpdatedIndex, bar_index)
                bool passFilter = true
                if minSwingPct > 0.0
                    float swing = math.abs(formingLevel - chochLevel)
                    float midpoint = (formingLevel + chochLevel) / 2.0
                    passFilter := midpoint <= 0.0 or swing / midpoint * 100.0 >= minSwingPct
                if passFilter
                    BosRec bos = BosRec.new(index = bosCounter, direction = direction, anchorIndex = anchorIndex, startIndex = formingStartIndex, level = formingLevel, levelLastUpdatedIndex = formingLevelLastUpdatedIndex, completeIndex = formingCompleteIndex, huntIndex = bar_index, state = BOS_CONFIRMED, hunted = true)
                    array.push(bosRecords, bos)
                    ChochTrack track = ChochTrack.new(bosIndex = bosCounter, candleIndex = chochIndex, level = chochLevel, firstHuntCandleIndex = na, direction = direction, active = true)
                    array.push(chochTracks, track)
                    array.push(activeBosIds, bosCounter)
                    color bosClr = direction == DIR_UP ? bullBosColor : bearBosColor
                    color chochClr = direction == DIR_UP ? bearChochColor : bullChochColor
                    f_drawBosLine(formingLevelLastUpdatedIndex, bar_index, formingLevel, bosClr)
                    f_drawMarkerLine(chochIndex, chochClr, line.style_solid, direction == DIR_DOWN)
                    dbgLastBosLevel := formingLevel
                    dbgLastBosStartIndex := formingStartIndex
                    dbgLastBosHuntIndex := bar_index
                    dbgLastChochLevel := chochLevel
                    dbgLastChochCandleIndex := chochIndex
                    f_confirmBosSection(activePotentialBosSectionId)
                    activePotentialBosSectionId := na
                    independentChochBeforePotentialBosSectionId := na
                    sectionDataChanged := true
                    bosCounter += 1
                    hasIndependentChoch := false
                else if not na(activePotentialBosSectionId)
                    // A rejected swing follows the existing reset path, so
                    // its potential section is finalized at the prior candle.
                    f_closeSection(activePotentialBosSectionId, bar_index - 1)
                    activePotentialBosSectionId := na
                    independentChochBeforePotentialBosSectionId := na
                    sectionDataChanged := true
                bosPhase := PHASE_WAIT_PULLBACK
                formingStartIndex := na
                formingLevel := na
                formingLevelLastUpdatedIndex := na
                formingCompleteIndex := na
                anchorIndex := bar_index + 1

// An open iCHoCH owns a visual section marker, so advance its right endpoint
// with the same bar that supplies its active logical endpoint.
if barstate.isconfirmed and not na(activeIndependentChochSectionId)
    LiquiditySection activeIndependentChochSection = array.get(liquiditySections, activeIndependentChochSectionId)
    if activeIndependentChochSection.active and not na(activeIndependentChochSection.independentChochDrawing)
        line.set_x2(activeIndependentChochSection.independentChochDrawing, bar_index)

//=============================================================================
// MAIN: PIVOT DETECTION
//=============================================================================

bool green = close > open
bool red = close < open
bool pivotDataChanged = false

if barstate.isconfirmed
    if array.size(alivePivotIds) > 0
        for alivePos = array.size(alivePivotIds) - 1 to 0
            int pivotId = array.get(alivePivotIds, alivePos)
            Pivot p = array.get(candidates, pivotId)
            if bar_index > p.confirmedBar and f_lowHunted(low, p.pivotLow)
                f_destroyPivot(pivotId)
                array.remove(alivePivotIds, alivePos)
                pivotDataChanged := true

    if array.size(pendingBullishPivotIds) > 0
        for pendingPos = array.size(pendingBullishPivotIds) - 1 to 0
            int pivotId = array.get(pendingBullishPivotIds, pendingPos)
            Pivot p = array.get(candidates, pivotId)
            if p.state == PENDING and bar_index > p.createdBar
                if low < p.runningMin
                    int previousPivotBar = p.runningMinBar
                    p.runningMin := low
                    p.runningMinBar := bar_index
                    f_markSectionsContainingPivotDirty(pivotId, previousPivotBar)
                    f_markSectionsContainingPivotDirty(pivotId, p.runningMinBar)
                    pivotDataChanged := true
                bool confirm = false
                bool invalidate = false
                if p.phase == WAIT_NEXT
                    if green
                        p.phase := GREEN_RUN
                        if f_highHunted(high, p.maxHigh)
                            confirm := true
                    else if red
                        p.phase := NORMAL
                else if p.phase == GREEN_RUN
                    if green and f_highHunted(high, p.maxHigh)
                        confirm := true
                    else if red
                        p.phase := NORMAL
                else if p.phase == NORMAL
                    bool highHunted = f_highHunted(high, p.maxHigh)
                    bool lowHunted = f_lowHunted(low, p.minLow)
                    if highHunted and lowHunted
                        confirm := sameCandleRule == "High wins"
                        invalidate := not confirm
                    else if highHunted
                        confirm := true
                    else if lowHunted
                        invalidate := true
                array.set(candidates, pivotId, p)
                if confirm
                    f_confirmPivot(pivotId)
                    pivotDataChanged := true
                else if invalidate
                    f_invalidatePivot(pivotId)
                    pivotDataChanged := true

if barstate.isconfirmed and green and redCount > 0
    float minValue = math.min(redMin, low)
    int minBar = low < redMin ? bar_index : redMinBar
    Pivot p = Pivot.new(createdBar = bar_index, minLow = minValue, minLowBar = minBar, maxHigh = redMax, runningMin = minValue, runningMinBar = minBar, pivotLow = na, pivotBar = na, state = PENDING, phase = WAIT_NEXT, confirmedBar = na, hunted = false, marker = na)
    int pivotId = array.size(candidates)
    array.push(candidates, p)
    array.push(pendingBullishPivotIds, pivotId)
    array.push(activeBullishPivotIds, pivotId)
    f_markSectionsContainingPivotDirty(pivotId, p.runningMinBar)
    pivotDataChanged := true
    if f_highHunted(high, redMax)
        f_confirmPivot(pivotId)

if barstate.isconfirmed
    if red
        if redCount == 0
            redMin := low
            redMinBar := bar_index
            redMax := na(precedingGreenMax) ? high : math.max(precedingGreenMax, high)
            precedingGreenMax := na
        else
            if low < redMin
                redMin := low
                redMinBar := bar_index
            redMax := math.max(redMax, high)
        redCount += 1
    else
        redCount := 0
        redMin := na
        redMinBar := na
        redMax := na
        if green
            precedingGreenMax := na(precedingGreenMax) ? high : math.max(precedingGreenMax, high)
        else
            precedingGreenMax := na

//=============================================================================
// MAIN: LIQUIDITY-LINE DETECTION
//=============================================================================

bool representativeStateChanged = false
if barstate.isconfirmed and (pivotDataChanged or sectionDataChanged) and array.size(liquiditySections) > 0
    // Only sections whose live state changed are refreshed. Their cached
    // representatives carry the preceding candle's result forward.
    for sectionId = array.size(liquiditySections) - 1 to 0
        LiquiditySection section = array.get(liquiditySections, sectionId)
        if section.representativeDirty
            representativeStateChanged := f_refreshSectionRepresentative(sectionId) or representativeStateChanged

if barstate.isconfirmed and representativeStateChanged
    f_matchHistoricalRepresentatives()

plot(showDebug ? dbgDirection : na, "Direction (1 up / -1 down)", display = display.data_window)
plot(showDebug ? dbgLastBosLevel : na, "Last BOS level", display = display.data_window)
plot(showDebug and not na(dbgLastBosStartIndex) ? dbgLastBosStartIndex : na, "Last BOS start index", display = display.data_window)
plot(showDebug and not na(dbgLastBosHuntIndex) ? dbgLastBosHuntIndex : na, "Last BOS hunt index", display = display.data_window)
plot(showDebug ? dbgLastChochLevel : na, "Last CHoCH level", display = display.data_window)
plot(showDebug and not na(dbgLastChochCandleIndex) ? dbgLastChochCandleIndex : na, "Last CHoCH candle index", display = display.data_window)
plot(showDebug ? array.size(activeBosIds) : na, "Active BOS count", display = display.data_window)
plot(showDebug ? array.size(bosRecords) : na, "All confirmed BOS records", display = display.data_window)
plot(showDebug ? array.size(chochTracks) : na, "CHoCH tracks", display = display.data_window)
plot(showDebug ? array.size(independentChochRecords) : na, "iCHoCH records", display = display.data_window)
plot(showDebug ? bosPhase : na, "BOS phase", display = display.data_window)
plot(showDebug ? array.size(historicalLiquidityLines) : na, "Historical liquidity lines", display = display.data_window)
plot(showDebug ? array.size(historicalLiquidityLines) : na, "Last historical line sequence", display = display.data_window)
plot(showDebug ? array.size(liquiditySections) : na, "BoS / iCHoCH sections", display = display.data_window)
plot(showDebug ? array.size(alivePivotIds) : na, "Alive pivots", display = display.data_window)
plot(showDebug ? array.size(pendingBullishPivotIds) : na, "Potential bullish pivots", display = display.data_window)
plot(showDebug ? array.size(activeBullishPivotIds) : na, "Live bullish pivots (pending + alive)", display = display.data_window)
plot(showDebug ? array.size(candidates) : na, "All pivot candidates", display = display.data_window)
