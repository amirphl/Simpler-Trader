//@version=6

indicator(
     "BOS_CHoCH_Detector",
     overlay = true,
     max_lines_count = 500,
     max_labels_count = 500
     )

//=============================================================================
// INPUTS
//=============================================================================
directionWindow = input.int(3, "Initial direction window", minval = 1)
huntModeInput = input.string(
     "wick",
     "Hunt mode",
     options = ["wick", "close"]
     )
includeHuntCandleInChochRange = input.bool(
     true,
     "Include BOS hunt candle in initial CHoCH range"
     )
minSwingPct = input.float(
     0.0,
     "Minimum swing percent",
     step = 0.01,
     minval = 0.0,
     tooltip = "If > 0, discard BOSes whose |bosLevel - chochLevel| / mid * 100 is below this threshold."
     )
includePullbackInBosLevel = input.bool(
     true,
     "Include first pullback candle in BOS level scan"
     )
chochMarkerLengthBars = input.int(
     1,
     "CHoCH marker length (bars)",
     minval = 1,
     maxval = 10
     )
markerOffsetTicks = input.int(
     6,
     "Marker vertical offset (ticks)",
     minval = 0
     )
markerWidth = input.int(
     2,
     "BOS line width",
     minval = 1,
     maxval = 5
     )
chochMarkerWidth = input.int(
     3,
     "CHoCH marker width",
     minval = 1,
     maxval = 5
     )
bullBosColor = input.color(color.lime, "Bullish BOS color")
bearBosColor = input.color(color.red, "Bearish BOS color")
bearChochColor = input.color(color.yellow, "Bearish CHoCH color")
bullChochColor = input.color(color.blue, "Bullish CHoCH color")
// Independent CHoCHs (iCHoCHs) deliberately use one distinct, fixed color.
// This keeps them visually separate from BOS-attached bullish/bearish CHoCHs.
color independentChochColor = color.purple
showDebug = input.bool(false, "Show debug values in Data Window")

// Pivot detector inputs. These mirror Pivot_Detection.pine so this BoS/CHoCH
// script exposes the current bullish-pivot state machine alongside structure.
touchCountsAsHunt = input.bool(false, "Touch counts as hunt")
sameCandleRule = input.string("Low wins", "If high and low are hunted on same candle", options = ["Low wins", "High wins"])
aliveColor = input.color(color.lime, "Alive pivot color")
deadColor = input.color(color.red, "Dead pivot color")
offsetTicks = input.int(10, "Icon offset ticks", minval = 0)
iconSizeInput = input.string("Large", "Icon size", options = ["Small", "Normal", "Large", "Huge"])

iconSize = iconSizeInput == "Small" ? size.small : iconSizeInput == "Normal" ? size.normal : iconSizeInput == "Huge" ? size.huge : size.large

//=============================================================================
// CONSTANTS
//=============================================================================
int DIR_UP   = 1
int DIR_DOWN = -1

int PHASE_WAIT_PULLBACK = 0
int PHASE_FORMING       = 1
int PHASE_AWAIT_HUNT    = 2

int BOS_FORMING   = 0
int BOS_COMPLETE  = 1
int BOS_CONFIRMED = 2

int PENDING = 0
int ALIVE = 1
int DEAD = 2
int INVALID = 3

int WAIT_NEXT = 0
int GREEN_RUN = 1
int NORMAL = 3

//=============================================================================
// TYPES
//=============================================================================
type BosRec
    int index
    int direction
    int anchorIndex
    int startIndex
    float level
    int levelLastUpdatedIndex
    int completeIndex
    int huntIndex
    int state
    bool hunted

type ChochTrack
    int bosIndex
    int candleIndex // initial structural CHoCH candle
    float level // current live level required for cascade detection
    int firstHuntCandleIndex // retained once; later hunts are not stored
    int direction
    bool active

type Pivot
    int createdBar
    float minLow
    int minLowBar
    float maxHigh
    float runningMin
    int runningMinBar
    float pivotLow
    int pivotBar
    int state
    int phase
    int confirmedBar
    label marker

//=============================================================================
// STORAGE
//=============================================================================
var array<BosRec> bosRecords = array.new<BosRec>()
var array<ChochTrack> chochTracks = array.new<ChochTrack>()
var array<int> activeBosIds = array.new_int()

var array<Pivot> candidates = array.new<Pivot>()
var array<int> alivePivots = array.new_int()

var bool initialized = false
var int direction = na
var int directionSinceIndex = na

var int anchorIndex = na
var int phase = PHASE_WAIT_PULLBACK
var int formingStartIndex = na
var float formingLevel = na
var int formingLevelLastUpdatedIndex = na
var int formingCompleteIndex = na
var int bosCounter = 0

var bool hasIndependentChoch = false
var float independentChochLevel = na
var int independentChochCandleIndex = na
var int independentChochDirection = na

var float dbgLastBosLevel = na
var int dbgLastBosStartIndex = na
var int dbgLastBosHuntIndex = na
var float dbgLastChochLevel = na
var int dbgLastChochCandleIndex = na
var int dbgDirection = na

var int redCount = 0
var float redMin = na
var int redMinBar = na
var float redMax = na
var float precedingGreenMax = na

//=============================================================================
// HELPER FUNCTIONS: historical absolute-index access
//=============================================================================
f_offsetFromAbsIndex(int absIndex) =>
    bar_index - absIndex

f_highAt(int absIndex) =>
    int off = f_offsetFromAbsIndex(absIndex)
    off >= 0 ? high[off] : na

f_lowAt(int absIndex) =>
    int off = f_offsetFromAbsIndex(absIndex)
    off >= 0 ? low[off] : na

f_openAt(int absIndex) =>
    int off = f_offsetFromAbsIndex(absIndex)
    off >= 0 ? open[off] : na

f_closeAt(int absIndex) =>
    int off = f_offsetFromAbsIndex(absIndex)
    off >= 0 ? close[off] : na

f_isBullAt(int absIndex) =>
    float o = f_openAt(absIndex)
    float c = f_closeAt(absIndex)
    not na(o) and not na(c) and c > o

f_isBearAt(int absIndex) =>
    float o = f_openAt(absIndex)
    float c = f_closeAt(absIndex)
    not na(o) and not na(c) and c < o

f_sideAt(int absIndex) =>
    f_isBullAt(absIndex) ? 1 : f_isBearAt(absIndex) ? -1 : 0

//=============================================================================
// HELPER FUNCTIONS: candle-direction logic
//=============================================================================
f_isOpposite(int dir, bool isBull, bool isBear) =>
    dir == DIR_UP ? isBear : isBull

f_isResume(int dir, bool isBull, bool isBear) =>
    dir == DIR_UP ? isBull : isBear

f_extremeValue(int dir, int absIndex) =>
    dir == DIR_UP ? f_highAt(absIndex) : f_lowAt(absIndex)

f_bosHunted(int dir, float level, string huntMode) =>
    if dir == DIR_UP
        float v = huntMode == "wick" ? high : close
        v >= level
    else
        float v = huntMode == "wick" ? low : close
        v <= level

f_chochHunted(int dir, float level, string huntMode) =>
    if dir == DIR_UP
        float v = huntMode == "wick" ? low : close
        v <= level
    else
        float v = huntMode == "wick" ? high : close
        v >= level

f_newChochLevel(int dir, string huntMode) =>
    if dir == DIR_UP
        huntMode == "wick" ? low : close
    else
        huntMode == "wick" ? high : close

//=============================================================================
// RANGE HELPERS
//=============================================================================
// UP direction   -> CHoCH structural level = minimum LOW in range
// DOWN direction -> CHoCH structural level = maximum HIGH in range
f_rangeCounterTrendExtreme(int dir, int startIdx, int endIdx) =>
    float outLevel = na
    int outIdx = na
    if startIdx > endIdx
        outLevel := dir == DIR_UP ? low : high
        outIdx := bar_index
    else
        outLevel := dir == DIR_UP ? f_lowAt(startIdx) : f_highAt(startIdx)
        outIdx := startIdx
        // FIX: only loop when there is more than one bar in [startIdx, endIdx].
        // Previously this ran unconditionally whenever startIdx <= endIdx, and
        // Pine's `for a to b` always executes at least once even when a > b
        // (it just iterates downward), so a single-bar range (startIdx == endIdx)
        // caused the loop to run for j = startIdx+1 (out of range) and then
        // j = startIdx again, corrupting the extreme value/index.
        if endIdx > startIdx
            if dir == DIR_UP
                for j = startIdx + 1 to endIdx
                    float candidate = f_lowAt(j)
                    if not na(candidate) and candidate < outLevel
                        outLevel := candidate
                        outIdx := j
            else
                for j = startIdx + 1 to endIdx
                    float candidate = f_highAt(j)
                    if not na(candidate) and candidate > outLevel
                        outLevel := candidate
                        outIdx := j
    [outLevel, outIdx]

// initial CHoCH for a confirmed BOS
f_initialChoch(int dir, int startIdx, int huntIdx, bool includeHunt) =>
    int endIdx = includeHunt ? huntIdx : huntIdx - 1
    int s = startIdx
    int e = endIdx
    if s > e
        s := huntIdx
        e := huntIdx
    f_rangeCounterTrendExtreme(dir, s, e)

//=============================================================================
// VISUAL HELPERS
//=============================================================================
f_drawMarkerLine(int absIndex, color clr, string sty, bool isBullish) =>
    if absIndex >= 0 and absIndex <= bar_index
        int off = f_offsetFromAbsIndex(absIndex)
        if off >= 0 and off <= bar_index
            float y = isBullish ? high[off] + syminfo.mintick * markerOffsetTicks : low[off] - syminfo.mintick * markerOffsetTicks
            line.new(
                 x1 = absIndex,
                 y1 = y,
                 x2 = absIndex + chochMarkerLengthBars,
                 y2 = y,
                 xloc = xloc.bar_index,
                 extend = extend.none,
                 color = clr,
                 style = sty,
                 width = chochMarkerWidth
                 )

f_drawBosLine(int levelIndex, int huntIndex, float level, color clr) =>
    if levelIndex >= 0 and levelIndex <= huntIndex and huntIndex <= bar_index
        line.new(
             x1 = levelIndex,
             y1 = level,
             x2 = huntIndex,
             y2 = level,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = clr,
             style = line.style_solid,
             width = markerWidth
             )

f_drawIndependentChochLine(int absIndex, bool isBullish) =>
    f_drawMarkerLine(absIndex, independentChochColor, line.style_solid, isBullish)

f_clearIntArray(array<int> arr) =>
    while array.size(arr) > 0
        array.pop(arr)

//=============================================================================
// PIVOT HELPERS
//=============================================================================

f_pivotHighHunted(float h, float level) =>
    touchCountsAsHunt ? h >= level : h > level

f_pivotLowHunted(float l, float level) =>
    touchCountsAsHunt ? l <= level : l < level

f_removePivotId(array<int> values, int value) =>
    if array.size(values) > 0
        for i = array.size(values) - 1 to 0
            if array.get(values, i) == value
                array.remove(values, i)

f_confirmPivot(int idx) =>
    Pivot p = array.get(candidates, idx)
    if p.state == PENDING
        p.state := ALIVE
        p.pivotLow := p.runningMin
        p.pivotBar := p.runningMinBar
        p.confirmedBar := bar_index
        p.marker := label.new(x = p.pivotBar, y = p.pivotLow - syminfo.mintick * offsetTicks, text = "▲", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = aliveColor, size = iconSize)
        f_removePivotId(alivePivots, idx)
        array.push(alivePivots, idx)
        array.set(candidates, idx, p)

f_invalidatePivot(int idx) =>
    Pivot p = array.get(candidates, idx)
    p.state := INVALID
    array.set(candidates, idx, p)

f_destroyPivot(int idx) =>
    Pivot p = array.get(candidates, idx)
    if p.state == ALIVE
        p.state := DEAD
        label.set_text(p.marker, "×")
        label.set_textcolor(p.marker, deadColor)
        array.set(candidates, idx, p)

// NOTE: f_resetFormation was removed — Pine Script does not allow a
// user-defined function to modify global-scope variables (CE10088), so
// the reset logic below is inlined at each call site instead. Every call
// site reset to bar_index anyway, so no behavior changes.

//=============================================================================
// INITIAL DIRECTION INFERENCE
//=============================================================================
if barstate.isconfirmed and not initialized and bar_index >= directionWindow - 1
    int effective = math.min(directionWindow, bar_index + 1)
    int score = 0
    for absIdx = 0 to effective - 1
        score += f_sideAt(absIdx)
    int inferred = DIR_UP
    if score > 0
        inferred := DIR_UP
    else if score < 0
        inferred := DIR_DOWN
    else
        inferred := DIR_UP
        for absIdx = effective - 1 to 0
            int s = f_sideAt(absIdx)
            if s > 0
                inferred := DIR_UP
                break
            if s < 0
                inferred := DIR_DOWN
                break
    direction := inferred
    directionSinceIndex := effective - 1
    anchorIndex := directionSinceIndex
    initialized := true
    dbgDirection := direction

//=============================================================================
// MAIN DETECTION
//=============================================================================
if barstate.isconfirmed and initialized and bar_index >= directionSinceIndex
    bool isBull = close > open
    bool isBear = close < open
    bool isDoji = close == open
    bool reversedNow = false

    //-------------------------------------------------------------------------
    // STEP A1: CHoCH cascade on active BOSes.
    //-------------------------------------------------------------------------
    if f_isOpposite(direction, isBull, isBear) and array.size(activeBosIds) > 0
        int newestBosId = array.get(activeBosIds, array.size(activeBosIds) - 1)
        bool newestHunted = false
        for k = 0 to array.size(activeBosIds) - 1
            int bosId = array.get(activeBosIds, k)
            if bosId >= 0 and bosId < array.size(chochTracks)
                ChochTrack tr = array.get(chochTracks, bosId)
                if tr.active and f_chochHunted(direction, tr.level, huntModeInput)
                    float newLevel = f_newChochLevel(direction, huntModeInput)
                    if na(tr.firstHuntCandleIndex)
                        tr.firstHuntCandleIndex := bar_index
                    tr.level := newLevel
                    array.set(chochTracks, bosId, tr)
                    dbgLastChochLevel := newLevel
                    dbgLastChochCandleIndex := bar_index
                    // Do not draw this per-BOS cascade marker. When the newest
                    // active BOS CHoCH is hunted, the block below reverses the
                    // direction and draws the independent CHoCH instead. Drawing
                    // both creates the redundant terminal CHoCH in every BOS run.
                    // color chochClr = direction == DIR_UP ? bearChochColor : bullChochColor
                    // f_drawMarkerLine(bar_index, chochClr, line.style_solid, direction == DIR_DOWN)
                    if bosId == newestBosId
                        newestHunted := true

        if newestHunted
            int newDirection = direction == DIR_UP ? DIR_DOWN : DIR_UP
            BosRec newestBos = array.get(bosRecords, newestBosId)
            int indepStart = newestBos.startIndex
            // FIX: previously this pre-declared indepLevel/indepIdx and then
            // tried to reassign them via tuple unpacking (`[a, b] = f()`),
            // which is a compile error in Pine — tuple unpacking always
            // declares new variables, it cannot reassign existing ones.
            // Also note: Pine tuple destructuring does not accept type
            // keywords inside the brackets — types are inferred, so this
            // must be `[indepLevel, indepIdx]`, not `[float indepLevel, ...]`.
            [indepLevel, indepIdx] = f_rangeCounterTrendExtreme(newDirection, indepStart, bar_index)
            independentChochLevel := indepLevel
            independentChochCandleIndex := indepIdx
            independentChochDirection := newDirection
            hasIndependentChoch := true
            // iCHoCH: UP is drawn below its candle; DOWN is drawn above.
            f_drawIndependentChochLine(indepIdx, newDirection == DIR_DOWN)
            direction := newDirection
            directionSinceIndex := bar_index
            dbgDirection := direction
            f_clearIntArray(activeBosIds)
            phase := PHASE_WAIT_PULLBACK
            formingStartIndex := na
            formingLevel := na
            formingLevelLastUpdatedIndex := na
            formingCompleteIndex := na
            anchorIndex := bar_index
            reversedNow := true

    //-------------------------------------------------------------------------
    // STEP A2: independent CHoCH cascade.
    //-------------------------------------------------------------------------
    if not reversedNow and hasIndependentChoch and f_isOpposite(direction, isBull, isBear)
        if f_chochHunted(direction, independentChochLevel, huntModeInput)
            int newDirection = direction == DIR_UP ? DIR_DOWN : DIR_UP
            // FIX: same tuple-reassignment bug as STEP A1, corrected the same way
            // (bare names only — no type keywords inside the brackets).
            [indepLevel2, indepIdx2] = f_rangeCounterTrendExtreme(newDirection, independentChochCandleIndex, bar_index)
            independentChochLevel := indepLevel2
            independentChochCandleIndex := indepIdx2
            independentChochDirection := newDirection
            hasIndependentChoch := true
            // iCHoCH: UP is drawn below its candle; DOWN is drawn above.
            f_drawIndependentChochLine(indepIdx2, newDirection == DIR_DOWN)
            direction := newDirection
            directionSinceIndex := bar_index
            dbgDirection := direction
            phase := PHASE_WAIT_PULLBACK
            formingStartIndex := na
            formingLevel := na
            formingLevelLastUpdatedIndex := na
            formingCompleteIndex := na
            anchorIndex := bar_index
            reversedNow := true

    //-------------------------------------------------------------------------
    // STEP B: BOS state machine
    //-------------------------------------------------------------------------
    if not reversedNow
        //=====================================================================
        // WAIT_PULLBACK
        //=====================================================================
        if phase == PHASE_WAIT_PULLBACK
            if f_isOpposite(direction, isBull, isBear)
                int startScan = anchorIndex
                int endScan = includePullbackInBosLevel ? bar_index : bar_index - 1
                float lvl = na
                int lvlIdx = na
                if endScan < startScan
                    lvl := f_extremeValue(direction, startScan)
                    lvlIdx := startScan
                else
                    lvl := f_extremeValue(direction, startScan)
                    lvlIdx := startScan
                    // FIX: guard the loop the same way as f_rangeCounterTrendExtreme —
                    // otherwise a single-bar scan window (endScan == startScan) makes
                    // Pine's for-loop run twice (j = startScan+1, then j = startScan)
                    // instead of zero times.
                    if endScan > startScan
                        for j = startScan + 1 to endScan
                            float candidate = f_extremeValue(direction, j)
                            if direction == DIR_UP
                                if candidate > lvl
                                    lvl := candidate
                                    lvlIdx := j
                            else
                                if candidate < lvl
                                    lvl := candidate
                                    lvlIdx := j
                formingStartIndex := bar_index
                formingLevel := lvl
                formingLevelLastUpdatedIndex := lvlIdx
                formingCompleteIndex := na
                phase := PHASE_FORMING

        //=====================================================================
        // FORMING
        //=====================================================================
        else if phase == PHASE_FORMING
            if f_isResume(direction, isBull, isBear)
                formingCompleteIndex := bar_index
                phase := PHASE_AWAIT_HUNT
                if f_bosHunted(direction, formingLevel, huntModeInput)
                    // FIX: bare names in tuple destructuring, no type keywords.
                    [chochLevel, chochIdx] = f_initialChoch(
                         direction,
                         formingLevelLastUpdatedIndex,
                         bar_index,
                         includeHuntCandleInChochRange
                         )
                    bool passFilter = true
                    if minSwingPct > 0.0
                        float swing = math.abs(formingLevel - chochLevel)
                        float mid = (formingLevel + chochLevel) / 2.0
                        if mid > 0.0 and swing / mid * 100.0 < minSwingPct
                            passFilter := false
                    if passFilter
                        BosRec bos = BosRec.new(
                             index = bosCounter,
                             direction = direction,
                             anchorIndex = anchorIndex,
                             startIndex = formingStartIndex,
                             level = formingLevel,
                             levelLastUpdatedIndex = formingLevelLastUpdatedIndex,
                             completeIndex = formingCompleteIndex,
                             huntIndex = bar_index,
                             state = BOS_CONFIRMED,
                             hunted = true
                             )
                        array.push(bosRecords, bos)
                        ChochTrack ct = ChochTrack.new(
                             bosIndex = bosCounter,
                             candleIndex = chochIdx,
                             level = chochLevel,
                             firstHuntCandleIndex = na,
                             direction = direction,
                             active = true
                             )
                        array.push(chochTracks, ct)
                        array.push(activeBosIds, bosCounter)
                        color bosClr = direction == DIR_UP ? bullBosColor : bearBosColor
                        color chochClr = direction == DIR_UP ? bearChochColor : bullChochColor
                        f_drawBosLine(formingLevelLastUpdatedIndex, bar_index, formingLevel, bosClr)
                        f_drawMarkerLine(chochIdx, chochClr, line.style_solid, direction == DIR_DOWN)
                        dbgLastBosLevel := formingLevel
                        dbgLastBosStartIndex := formingStartIndex
                        dbgLastBosHuntIndex := bar_index
                        dbgLastChochLevel := chochLevel
                        dbgLastChochCandleIndex := chochIdx
                        bosCounter += 1
                        hasIndependentChoch := false
                    phase := PHASE_WAIT_PULLBACK
                    formingStartIndex := na
                    formingLevel := na
                    formingLevelLastUpdatedIndex := na
                    formingCompleteIndex := na
                    anchorIndex := bar_index
            else if f_isOpposite(direction, isBull, isBear)
                float candidate = direction == DIR_UP ? high : low
                if direction == DIR_UP
                    if candidate > formingLevel
                        formingLevel := candidate
                        formingLevelLastUpdatedIndex := bar_index
                else
                    if candidate < formingLevel
                        formingLevel := candidate
                        formingLevelLastUpdatedIndex := bar_index

        //=====================================================================
        // AWAIT_HUNT
        //=====================================================================
        else if phase == PHASE_AWAIT_HUNT
            if f_bosHunted(direction, formingLevel, huntModeInput)
                // FIX: bare names in tuple destructuring, no type keywords.
                [chochLevel, chochIdx] = f_initialChoch(
                     direction,
                     formingLevelLastUpdatedIndex,
                     bar_index,
                     includeHuntCandleInChochRange
                     )
                bool passFilter = true
                if minSwingPct > 0.0
                    float swing = math.abs(formingLevel - chochLevel)
                    float mid = (formingLevel + chochLevel) / 2.0
                    if mid > 0.0 and swing / mid * 100.0 < minSwingPct
                        passFilter := false
                if passFilter
                    BosRec bos = BosRec.new(
                         index = bosCounter,
                         direction = direction,
                         anchorIndex = anchorIndex,
                         startIndex = formingStartIndex,
                         level = formingLevel,
                         levelLastUpdatedIndex = formingLevelLastUpdatedIndex,
                         completeIndex = formingCompleteIndex,
                         huntIndex = bar_index,
                         state = BOS_CONFIRMED,
                         hunted = true
                         )
                    array.push(bosRecords, bos)
                    ChochTrack ct = ChochTrack.new(
                             bosIndex = bosCounter,
                             candleIndex = chochIdx,
                             level = chochLevel,
                             firstHuntCandleIndex = na,
                             direction = direction,
                         active = true
                         )
                    array.push(chochTracks, ct)
                    array.push(activeBosIds, bosCounter)
                    color bosClr = direction == DIR_UP ? bullBosColor : bearBosColor
                    color chochClr = direction == DIR_UP ? bearChochColor : bullChochColor
                    f_drawBosLine(formingLevelLastUpdatedIndex, bar_index, formingLevel, bosClr)
                    f_drawMarkerLine(chochIdx, chochClr, line.style_solid, direction == DIR_DOWN)
                    dbgLastBosLevel := formingLevel
                    dbgLastBosStartIndex := formingStartIndex
                    dbgLastBosHuntIndex := bar_index
                    dbgLastChochLevel := chochLevel
                    dbgLastChochCandleIndex := chochIdx
                    bosCounter += 1
                    hasIndependentChoch := false
                phase := PHASE_WAIT_PULLBACK
                formingStartIndex := na
                formingLevel := na
                formingLevelLastUpdatedIndex := na
                formingCompleteIndex := na
                anchorIndex := bar_index

//=============================================================================
// MAIN: PIVOT DETECTION
//=============================================================================

bool green = close > open
bool red = close < open

if barstate.isconfirmed
    // Hunt every confirmed bullish pivot as soon as a later candle crosses its
    // low. Candle colour is deliberately irrelevant to a liquidity hunt.
    if array.size(alivePivots) > 0
        for i = array.size(alivePivots) - 1 to 0
            int idx = array.get(alivePivots, i)
            Pivot p = array.get(candidates, idx)
            if bar_index > p.confirmedBar and f_pivotLowHunted(low, p.pivotLow)
                f_destroyPivot(idx)
                array.remove(alivePivots, i)

    // Let potential pivots update their running low and transition through
    // confirmation/invalidation. Persist local changes before a helper changes
    // the record state, avoiding a stale PENDING write over ALIVE/INVALID.
    if array.size(candidates) > 0
        for i = array.size(candidates) - 1 to 0
            Pivot p = array.get(candidates, i)
            if p.state == PENDING and bar_index > p.createdBar
                if low < p.runningMin
                    p.runningMin := low
                    p.runningMinBar := bar_index

                bool confirm = false
                bool invalidate = false

                if p.phase == WAIT_NEXT
                    if green
                        p.phase := GREEN_RUN
                        if f_pivotHighHunted(high, p.maxHigh)
                            confirm := true
                    else if red
                        p.phase := NORMAL
                else if p.phase == GREEN_RUN
                    if green
                        if f_pivotHighHunted(high, p.maxHigh)
                            confirm := true
                    else if red
                        p.phase := NORMAL
                else if p.phase == NORMAL
                    bool highHunted = f_pivotHighHunted(high, p.maxHigh)
                    bool lowHunted = f_pivotLowHunted(low, p.minLow)
                    if highHunted and lowHunted
                        if sameCandleRule == "High wins"
                            confirm := true
                        else
                            invalidate := true
                    else if highHunted
                        confirm := true
                    else if lowHunted
                        invalidate := true

                array.set(candidates, i, p)
                if confirm
                    f_confirmPivot(i)
                else if invalidate
                    f_invalidatePivot(i)

// Red sequence followed by green: create a new potential bullish pivot.
if barstate.isconfirmed and green and redCount > 0
    float minValue = math.min(redMin, low)
    int minBar = low < redMin ? bar_index : redMinBar
    Pivot p = Pivot.new(createdBar = bar_index, minLow = minValue, minLowBar = minBar, maxHigh = redMax, runningMin = minValue, runningMinBar = minBar, pivotLow = na, pivotBar = na, state = PENDING, phase = WAIT_NEXT, confirmedBar = na, marker = na)
    int idx = array.size(candidates)
    array.push(candidates, p)

    // A trigger-green candle may confirm the new pivot immediately.
    if f_pivotHighHunted(high, redMax)
        f_confirmPivot(idx)

if barstate.isconfirmed
    if red
        if redCount == 0
            redMin := low
            redMinBar := bar_index
            redMax := na(precedingGreenMax) ? high : math.max(precedingGreenMax, high)
            precedingGreenMax := na
        else
            if low < redMin
                redMin := low
                redMinBar := bar_index
            redMax := math.max(redMax, high)
        redCount += 1
    else
        redCount := 0
        redMin := na
        redMinBar := na
        redMax := na
        if green
            precedingGreenMax := na(precedingGreenMax) ? high : math.max(precedingGreenMax, high)
        else
            precedingGreenMax := na

//=============================================================================
// DEBUG PLOTS
//=============================================================================
plot(showDebug ? dbgDirection : na, "Direction (1 up / -1 down)", display = display.data_window)
plot(showDebug ? dbgLastBosLevel : na, "Last BOS level", display = display.data_window)
plot(showDebug and not na(dbgLastBosStartIndex) ? dbgLastBosStartIndex : na, "Last BOS start index", display = display.data_window)
plot(showDebug and not na(dbgLastBosHuntIndex) ? dbgLastBosHuntIndex : na, "Last BOS hunt index", display = display.data_window)
plot(showDebug ? dbgLastChochLevel : na, "Last CHoCH level", display = display.data_window)
plot(showDebug and not na(dbgLastChochCandleIndex) ? dbgLastChochCandleIndex : na, "Last CHoCH candle index", display = display.data_window)
plot(showDebug ? array.size(activeBosIds) : na, "Active BOS count", display = display.data_window)
plot(showDebug ? phase : na, "Phase", display = display.data_window)
plot(showDebug ? redCount : na, "Red sequence length", display = display.data_window)
plot(showDebug ? array.size(alivePivots) : na, "Alive pivots", display = display.data_window)
plot(showDebug ? array.size(candidates) : na, "All pivot candidates", display = display.data_window)
